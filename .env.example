# Same Neon database as Travola-OS and Travola-POS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&channel_binding=require"
# Must be BYTE-IDENTICAL to the SESSION_SECRET set on Travola-OS and Travola-POS.
SESSION_SECRET="<32+ random bytes, base64>"
# Where this console sends managers when they launch the other two apps.
NEXT_PUBLIC_FLOOR_URL="https://travola-os-tablai.vercel.app"
NEXT_PUBLIC_POS_URL="https://pos.travola.app"
# Billing provider: "stub" (database-backed, default) or "stripe".
BILLING_PROVIDER="stub"
# STRIPE_PRICE_STARTER=""
# STRIPE_PRICE_STANDARD=""
# STRIPE_PRICE_PRO=""

# ─── Stripe Connect: deposits ─────────────────────────────────────
# Optional. Without these the deposit settings still render and still
# save preferences — they just cannot connect a bank account, and say so.
#
# Travola runs Connect EXPRESS: each restaurant gets its OWN Stripe
# account and completes Stripe's own KYC, so money moves card → the
# restaurant's bank without passing through a Travola balance.
#
# A test key (sk_test_...) makes the whole flow work end to end against
# Stripe's sandbox; the UI labels itself as test mode so nobody mistakes
# a sandbox connection for one that will actually pay them.
STRIPE_SECRET_KEY=""

# From the webhook endpoint you create in Stripe pointing at
#   https://<your-home-domain>/api/webhooks/stripe
# Subscribe to: account.updated, account.application.deauthorized
# Without it that route rejects EVERY request rather than trusting an
# unverified payload — an unverified webhook is an open write endpoint.
STRIPE_WEBHOOK_SECRET=""
